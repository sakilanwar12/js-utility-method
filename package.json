{
  "name": "js-utility-method",
  "author": "Sakil Anwar",
  "version": "2.0.3",
  "description": "A collection of common utility functions in TypeScript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --watch",
    "prepare": "pnpm run build && pnpm run test",
    "lint": "eslint src --ext .ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "push": "git push && git push --tags",
    "publish:patch": "pnpm run version:patch && pnpm run push && pnpm publish --access public",
    "publish:minor": "pnpm run version:minor && pnpm run push && pnpm publish --access public",
    "publish:major": "pnpm run version:major && pnpm run push && pnpm publish --access public"
  },
  "keywords": [
    "utility",
    "typescript",
    "js-utility-method",
    "js-utils",
    "utility-functions",
    "utility-methods",
    "common-helpers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sakilanwar12/js-utility-method.git"
  },
  "homepage": "https://github.com/sakilanwar12/js-utility-method#readme",
  "bugs": {
    "url": "https://github.com/sakilanwar12/js-utility-method/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.26"
  }
}
